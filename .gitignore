# ============================================================
# WEB-P007 — Internship Management System
# Root ignore rules for frontend, admin and backend
# ============================================================

# Dependencies
**/node_modules/

# Build output
**/dist/
**/dist-ssr/
**/build/
**/out/
**/.output/

# Generated Prisma Client
**/generated/prisma/

# Tool caches
**/.vite/
**/.turbo/
**/.cache/
**/.parcel-cache/
**/coverage/
**/.nyc_output/

# TypeScript build artifacts
**/*.tsbuildinfo

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*

# Runtime files
**/pids/
**/*.pid
**/*.pid.lock

# Temporary files
**/tmp/
**/temp/
**/*.local
**/*.local.*

# Operating system files
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
.AppleDouble
.LSOverride

# IDE configuration
**/.idea/
**/.fleet/
**/.vscode/*
!**/.vscode/extensions.json

# Editor temporary files
**/*.swp
**/*.swo
**/*~

# Local database files
**/*.sqlite
**/*.sqlite3
**/*.db-journal

# Private keys and certificates
**/*.key
**/*.p12
**/*.pfx