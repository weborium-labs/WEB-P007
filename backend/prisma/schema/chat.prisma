model Conversation {
  id        String    @id @default(uuid())
  batchId   String?   @unique // Enforces exactly one channel per batch
  teamId    String?   @unique // Enforces exactly one channel per team

  batch     Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([batchId, teamId])
}

model Message {
  id             String       @id @default(uuid())
  text           String
  attachments    String[]
  key            String       // E2EE encrypted key/nonce reference
  conversationId String
  senderId       String
  
  // CHAT-07: Soft-delete and moderation audit
  deletedAt      DateTime?
  deletedBy      String?      // User ID of sender or Admin/GPM moderator
  
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}