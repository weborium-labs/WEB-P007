model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String   // e.g. "UPDATE_SCORE", "OVERRIDE_ATTENDANCE", "KYC_REJECT"
  entityType String   // "User", "Attendance", "Task", "Document"
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, entityType])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "MIN_ATTENDANCE_PCT", "INACTIVITY_DAYS_DEACTIVATE"
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}